            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="extpanel" value="&lt;b&gt;Liên kết ra phân hệ khác (FK)&lt;/b&gt;&lt;br&gt;Chân quạ + vòng tròn = 0..N; gạch đơn = 1. Line đỏ = FK nội phân hệ.&lt;br&gt;• lease.id ← invoice.lease_id, meter_reading.lease_id&lt;br&gt;• owner_tenant.id ← invoice.tenant_id, meter_reading.tenant_id,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;invoice_line.tenant_id, payment_record.tenant_id&lt;br&gt;• room.id ← meter_reading.room_id&lt;br&gt;• tariff.id ← invoice_line.source_tariff_id&lt;br&gt;• user.id ← invoice.issued_by, invoice.voided_by, meter_reading.created_by,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;payment_record.submitted_by, payment_record.confirmed_by&lt;br&gt;• &lt;b&gt;Invoice&lt;/b&gt; chờ Renter xác nhận; quá 72 giờ → Issued với &lt;b&gt;unconfirmed_invoice&lt;/b&gt; + audit (BR-54, D-26)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=10.5;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="70" y="1144" width="870" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>








