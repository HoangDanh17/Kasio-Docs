  <diagram id="identity" name="01 Identity &amp; Access">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pagetitle" value="Identity &amp; Access — ERD chi tiết" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2d3d;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="28" width="1100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="pagenote" value="8 thực thể · 11 khóa ngoại · PK/FK/UQ ở cột đầu · nguồn: ERD_logical.sql + BRD v1.6 §3.2, §9.1 · kiểu dữ liệu là placeholder logic" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#667085;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="64" width="1100" height="22" as="geometry" />
        </mxCell>
        <UserObject label="← 00 Tổng quan" link="data:page/id,overview" id="backlink">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a73e8;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
            <mxGeometry x="70" y="96" width="150" height="22" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="legend" value="&lt;b style=&quot;font-size:13px&quot;&gt;Đọc ERD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; Danh tính toàn nền tảng &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; Tenant &amp;amp; thành viên &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; RBAC&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;━&lt;/font&gt; → user &amp;nbsp; &lt;font color=&quot;#9673a6&quot;&gt;━&lt;/font&gt; → owner_tenant &amp;nbsp; &lt;font color=&quot;#82b366&quot;&gt;━&lt;/font&gt; → role / permission&lt;br&gt;Chân quạ + vòng tròn ở phía &lt;b&gt;0..N&lt;/b&gt;; gạch đơn ở phía &lt;b&gt;1&lt;/b&gt;.&lt;br&gt;&lt;b&gt;1:1&lt;/b&gt; · platform_admin.user_id vừa PK vừa FK;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;owner_tenant.owner_user_id unique.&lt;br&gt;&lt;b&gt;staff_membership&lt;/b&gt; · unique user_id khi status = Active:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;một Staff chỉ thuộc một Owner.&lt;br&gt;&lt;b&gt;role&lt;/b&gt; · unique (tenant_id, name).&lt;br&gt;&lt;b&gt;role_assignment&lt;/b&gt; · unique (membership_id, role_id).&lt;br&gt;&lt;b&gt;role_permission&lt;/b&gt; · PK tổ hợp&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(tenant_id, role_id, permission_code).&lt;br&gt;&lt;b&gt;property_scope&lt;/b&gt; giới hạn role theo Property;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kiểm tra quyền = membership + role + scope." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="760" height="250" as="geometry" />
        </mxCell>
