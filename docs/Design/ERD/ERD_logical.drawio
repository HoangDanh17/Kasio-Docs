        <mxCell id="extpanel" value="&lt;b&gt;Liên kết ra phân hệ khác (FK)&lt;/b&gt;&lt;br&gt;Chân quạ + vòng tròn = 0..N; gạch đơn = 1. Line tím = FK nội phân hệ.&lt;br&gt;• owner_tenant.id ← lease_template.tenant_id, lease.tenant_id, lease_version.tenant_id,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lease_revision.tenant_id, lease_signature.tenant_id, occupant.tenant_id, occupant_document.tenant_id&lt;br&gt;• room.id ← lease.room_id&lt;br&gt;• user.id ← lease_template.created_by, lease_version.created_by, lease_revision.actor_user_id,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lease_signature.user_id, lease.representative_user_id, occupant_document.uploaded_by&lt;br&gt;• &lt;b&gt;LeaseTemplate&lt;/b&gt; unique (scope, tenant_id, code, version); &lt;b&gt;LeaseRevision&lt;/b&gt; unique (lease_id, revision_no), append-only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=10.5;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="70" y="1280" width="870" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>








